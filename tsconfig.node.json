{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "./src/auto-imports.d.ts",
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "eslint.config.*",
    "src/**/*.vue",
    "vite.config.*",
    "vitest.config.*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "esnext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "composite": true
}
