{
  "name": "gmap-viewer",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "deploy": "npm run build-only && cd dist && git add . && git commit -m \"Deploy build $(date +'%Y-%m-%d %H:%M:%S')\" && git push -f origin HEAD:deploy && cd .."
  },
  "dependencies": {
    "@vueuse/core": "^14.0.0",
    "https": "^1.0.0",
    "ol": "^10.7.0",
    "ol-contextmenu": "^5.5.0",
    "ol-ext": "^4.0.36",
    "pinia": "^3.0.3",
    "proxy-agent": "^6.5.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.22",
    "vue3-openlayers": "^12.2.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.2.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
